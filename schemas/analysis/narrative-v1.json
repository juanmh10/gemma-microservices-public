{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/gemma-pipeline/analysis/narrative-v1",
  "title": "Part 2 narrative v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "summary",
    "findings",
    "recommendations",
    "limitations"
  ],
  "properties": {
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "observation",
          "metric_refs"
        ],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,62}$"
          },
          "observation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "metric_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "maxItems": 10,
            "minItems": 1
          }
        }
      },
      "maxItems": 10,
      "minItems": 0
    },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      },
      "maxItems": 10,
      "minItems": 0
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      },
      "maxItems": 10,
      "minItems": 1
    }
  }
}
