{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Worker A domain configuration v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "task",
    "outcomes",
    "causes",
    "evidence_role"
  ],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,63}$"
    },
    "task": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "evidence_role": {
      "enum": [
        "customer",
        "seller"
      ]
    },
    "outcomes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "success",
        "failure"
      ],
      "properties": {
        "success": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "failure": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      }
    },
    "causes": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 64,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]{0,63}$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      }
    }
  }
}
