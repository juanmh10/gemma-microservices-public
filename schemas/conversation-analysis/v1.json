{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/gemma-pipeline/conversation-analysis/v1",
  "title": "Generic Worker A conversation analysis v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "conversation_id",
    "outcome",
    "causes"
  ],
  "properties": {
    "conversation_id": {
      "type": "string",
      "pattern": "^conv_[0-9]{6,}$"
    },
    "outcome": {
      "enum": [
        "success",
        "failure"
      ]
    },
    "causes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "confidence",
          "evidence_turns"
        ],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "evidence_turns": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    }
  }
}
