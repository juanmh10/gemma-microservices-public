{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/gemma-pipeline/conversation/v1",
  "title": "Canonical conversation v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["record_id", "messages"],
  "properties": {
    "record_id": {"type": "string", "pattern": "^conv_[0-9]{6,}$"},
    "messages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["turn_id", "role", "text"],
        "properties": {
          "turn_id": {"type": "integer", "minimum": 1},
          "role": {"enum": ["seller", "customer"]},
          "text": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
