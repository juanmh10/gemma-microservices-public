{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Dataset manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["run_id", "dataset_version", "schema_version", "prompt_version", "records_total", "shards"],
  "properties": {
    "run_id": {"type": "string", "minLength": 1},
    "dataset_version": {"const": "gym-sales-v1"},
    "schema_version": {"const": "sales-analysis-v1"},
    "prompt_version": {"const": "worker-a-v1"},
    "records_total": {"type": "integer", "minimum": 1},
    "shards": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["index", "uri", "records", "sha256"],
        "properties": {
          "index": {"type": "integer", "minimum": 0},
          "uri": {"type": "string", "minLength": 1},
          "records": {"type": "integer", "minimum": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  }
}
