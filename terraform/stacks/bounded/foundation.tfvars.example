# Optional one-task definition profile; use only with an approved workload.
# Copy to an ignored private file and supply fresh run_id, rtx_canary_id,
# immutable images, source revisions and required private configuration.
deploy_jobs               = true
deploy_preparer           = true
deploy_l4                 = false
retain_worker_network     = true
pilot_records             = 300
preparer_shards           = 1
prompt_version            = "worker-a-v2"
require_rtx_compile_cache = true
export_rtx_compile_cache  = false
rtx_canary_tasks          = 1
